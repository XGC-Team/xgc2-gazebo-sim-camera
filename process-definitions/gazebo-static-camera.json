{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "gazebo-static-camera",
      "version": "1.5.0",
      "label": "Gazebo fixed-site RGB camera",
      "description": "Runs the per-camera ROS CameraInfo metadata registration and TF publishers. Core starts this runtime in parallel with media-edge, then places the camera through the finite placement CLI after awaiting the world. The camera-source authority is the plugin inside gzserver.",
      "parameters": {
        "groups": [
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri"
            ]
          }
        ],
        "properties": {
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "modelName": {
            "type": "string",
            "default": "gazebo_static_camera"
          },
          "cameraLinkFrame": {
            "type": "string",
            "default": "xgc_world_camera_link"
          },
          "opticalFrame": {
            "type": "string",
            "default": "xgc_world_camera_optical_frame"
          },
          "parentFrame": {
            "type": "string",
            "default": "world"
          },
          "gtCameraLinkFrame": {
            "type": "string",
            "default": "usb_cam_link_gt"
          },
          "gtOpticalFrame": {
            "type": "string",
            "default": "usb_cam_optical_frame_gt"
          },
          "cameraProfile": {
            "type": "string",
            "default": "world_wide_4k30_110",
            "enum": [
              "world_wide_4k30_110"
            ]
          },
          "cameraName": {
            "type": "string",
            "default": "usb_cam"
          },
          "intrinsicFile": {
            "type": "string",
            "default": "",
            "x-xgc-path-kind": "file",
            "x-xgc-file-extensions": [
              ".yaml"
            ]
          },
          "extrinsicFile": {
            "type": "string",
            "default": "",
            "description": "Explicit extrinsics-UTC.yaml used for runtime TF when poseSource is file.",
            "x-xgc-path-kind": "file",
            "x-xgc-file-extensions": [
              ".yaml"
            ]
          },
          "poseSource": {
            "type": "string",
            "description": "authored uses x/y/z/rpy for runtime TF. file or resolved initializes TF from the selected extrinsic. Placement receives its pose separately.",
            "default": "authored",
            "enum": [
              "authored",
              "file",
              "resolved"
            ]
          },
          "calibrationRoot": {
            "type": "string",
            "x-xgc-path-kind": "directory"
          },
          "selectedPhysicalOpticalFrame": {
            "type": "string",
            "default": "usb_cam_optical_frame"
          },
          "mediaSourceId": {
            "type": "string",
            "default": "usb_cam"
          },
          "mediaControlEndpoint": {
            "type": "string",
            "fixedOnly": true,
            "description": "Camera-source Unix socket served by the plugin inside gzserver; Core passes the camera inventory's opaque rendezvous path."
          },
          "mediaControlTargetId": {
            "type": "string",
            "description": "Explicit local target identity granted to camera source control."
          },
          "pythonExecutable": {
            "type": "string",
            "description": "Selected interpreter with the released XRPC wheel and ROS modules installed.",
            "fixedOnly": true,
            "x-xgc-path-kind": "file"
          },
          "x": {
            "type": "number",
            "default": -4.0,
            "description": "Runtime TF pose; must match the separately placed camera when publishing truth."
          },
          "y": {
            "type": "number",
            "default": 0.0,
            "description": "Runtime TF pose; must match the separately placed camera when publishing truth."
          },
          "z": {
            "type": "number",
            "default": 1.5,
            "description": "Runtime TF pose; must match the separately placed camera when publishing truth."
          },
          "roll": {
            "type": "number",
            "default": 0.0,
            "description": "Runtime TF pose; must match the separately placed camera when publishing truth."
          },
          "pitch": {
            "type": "number",
            "default": 0.0,
            "description": "Runtime TF pose; must match the separately placed camera when publishing truth."
          },
          "yaw": {
            "type": "number",
            "default": 0.0,
            "description": "Runtime TF pose; must match the separately placed camera when publishing truth."
          },
          "mode": {
            "type": "string",
            "default": "truth",
            "enum": [
              "truth",
              "calibration",
              "validation"
            ]
          },
          "publishTruthTf": {
            "type": "boolean",
            "default": true
          },
          "publishXgcContract": {
            "type": "boolean",
            "default": true
          },
          "resolvedExtrinsicJson": {
            "type": "string",
            "description": "One immutable extrinsic resolution produced by the camera workflow.",
            "default": ""
          },
          "frameRolesJson": {
            "type": "string",
            "default": "{\"parentFrame\":\"world\",\"opticalFrames\":{\"sim\":\"xgc_world_camera_optical_frame\",\"phy\":\"usb_cam_optical_frame\"}}"
          }
        },
        "required": [
          "mediaControlEndpoint",
          "mediaControlTargetId",
          "pythonExecutable"
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc_camera_calibration/gazebo_camera_from_extrinsic.py",
        "args": [
          "--resolved-extrinsic-json",
          "${resolvedExtrinsicJson}",
          "--frame-roles-json",
          "${frameRolesJson}",
          "--pose-source",
          "${poseSource}",
          "--calibration-root",
          "${calibrationRoot}",
          "--camera-name",
          "${cameraName}",
          "--parent-frame",
          "${parentFrame}",
          "--optical-frame",
          "${opticalFrame}",
          "--selected-physical-optical-frame",
          "${selectedPhysicalOpticalFrame}",
          "--extrinsic-file",
          "${extrinsicFile}",
          "--optical-offset-x",
          "0.067",
          "--optical-offset-y",
          "0",
          "--optical-offset-z",
          "0",
          "--",
          "/opt/ros/noetic/bin/roslaunch",
          "--wait",
          "gazebo_sim_camera",
          "static_camera.launch",
          "media_control_target_id:=${mediaControlTargetId}",
          "python_executable:=${pythonExecutable}",
          "use_sim_time:=true",
          "model_name:=${modelName}",
          "camera_link_frame:=${cameraLinkFrame}",
          "optical_frame:=${opticalFrame}",
          "parent_frame:=${parentFrame}",
          "gt_camera_link_frame:=${gtCameraLinkFrame}",
          "gt_optical_frame:=${gtOpticalFrame}",
          "camera_profile:=${cameraProfile}",
          "camera_name:=${cameraName}",
          "calibration_root:=${calibrationRoot}",
          "intrinsic_file:=${intrinsicFile}",
          "media_source_id:=${mediaSourceId}",
          "media_control_endpoint:=${mediaControlEndpoint}",
          "x:=${x}",
          "y:=${y}",
          "z:=${z}",
          "roll:=${roll}",
          "pitch:=${pitch}",
          "yaw:=${yaw}",
          "mode:=${mode}",
          "publish_truth_tf:=${publishTruthTf}",
          "publish_xgc_contract:=${publishXgcContract}",
          "xgc_transform_topic:=/xgc/camera/world/tf"
        ],
        "env": {
          "ROS_MASTER_URI": "${rosMasterUri}"
        }
      },
      "setupFiles": [
        "/opt/ros/noetic/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 5000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
