<?xml version="1.0"?>
<launch>
  <!-- Per-camera ROS runtime. Core owns the world and finite placement. -->
  <arg name="use_sim_time" default="true"/>
  <arg name="model_name" default="gazebo_static_camera"/>
  <arg name="camera_link_frame" default="usb_cam_link"/>
  <arg name="optical_frame" default="usb_cam_optical_frame"/>
  <arg name="camera_profile" default="world_wide_4k30_110"/>
  <arg name="camera_name" default="usb_cam"/>
  <arg name="camera_profiles_file"
       default="$(find gazebo_sim_camera)/config/world_camera_profiles.yaml"/>
  <arg name="intrinsic_file" default=""/>
  <arg name="media_source_id" default="usb_cam"/>
  <arg name="media_control_endpoint"/>
  <arg name="media_control_target_id"/>
  <arg name="python_executable"/>
  <arg name="gt_camera_link_frame" default="usb_cam_link_gt"/>
  <arg name="gt_optical_frame" default="usb_cam_optical_frame_gt"/>
  <arg name="parent_frame" default="world"/>
  <arg name="width" default="profile"/>
  <arg name="height" default="profile"/>
  <arg name="hfov_degrees" default="profile"/>
  <arg name="x" default="-4.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="1.5"/>
  <arg name="roll" default="0.0"/>
  <arg name="pitch" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="mode" default="truth"/>
  <arg name="publish_truth_tf" default="true"/>
  <arg name="calibration_root" default=""/>
  <arg name="resolved_extrinsic_json" default=""/>
  <arg name="frame_roles_json" default=""/>
  <arg name="publish_xgc_contract" default="true"/>
  <arg name="xgc_transform_topic" default="/xgc/camera/world/tf"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <node if="$(arg publish_xgc_contract)"
        pkg="gazebo_sim_camera" type="camera_contract_publisher.py" launch-prefix="$(arg python_executable)"
        name="$(arg model_name)_xgc_camera_contract" output="screen">
    <!-- This world-camera product owns the XGC CameraInfo/TF contract.
         CameraInfo uses the selected intrinsic YAML when supplied; the profile
         remains the pre-calibration fallback used by intrinsic capture itself.
         Still images are explicit source-control snapshots, not a ROS timer. -->
    <param name="calibration_root" value="$(arg calibration_root)"/>
    <param name="resolved_extrinsic_json" type="str" value="$(arg resolved_extrinsic_json)"/>
    <param name="frame_roles_json" type="str" value="$(arg frame_roles_json)"/>
    <param name="camera_profile" value="$(arg camera_profile)"/>
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="camera_profiles_file" value="$(arg camera_profiles_file)"/>
    <param name="intrinsic_file" value="$(arg intrinsic_file)"/>
    <param name="width" value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
    <param name="hfov_degrees" value="$(arg hfov_degrees)"/>
    <param name="media_source_id" value="$(arg media_source_id)"/>
    <param name="media_control_endpoint" value="$(arg media_control_endpoint)"/>
    <param name="media_control_target_id" value="$(arg media_control_target_id)"/>
    <param name="output_transform_topic" value="$(arg xgc_transform_topic)"/>
    <param name="parent_frame" value="$(arg parent_frame)"/>
    <!-- CameraInfo and camera-local TF share the exact frames embedded by the
         media plugin in video, timing, stream metadata, and snapshots. There
         is intentionally no second independently configurable frame pair. -->
    <param name="camera_link_frame" value="$(arg camera_link_frame)"/>
    <param name="optical_frame" value="$(arg optical_frame)"/>
    <param name="x" value="$(arg x)"/>
    <param name="y" value="$(arg y)"/>
    <param name="z" value="$(arg z)"/>
    <param name="roll" value="$(arg roll)"/>
    <param name="pitch" value="$(arg pitch)"/>
    <param name="yaw" value="$(arg yaw)"/>
    <param name="transform_publish_rate" value="10"/>
  </node>

  <group if="$(eval arg('mode') == 'truth' and arg('publish_truth_tf'))">
    <node pkg="tf" type="static_transform_publisher" name="$(arg model_name)_truth_pose"
          args="$(arg x) $(arg y) $(arg z) $(arg yaw) $(arg pitch) $(arg roll)
            $(arg parent_frame) $(arg camera_link_frame) 100"/>
    <node pkg="tf" type="static_transform_publisher" name="$(arg model_name)_optical_frame"
          args="0.067 0 0 -1.5707963267948966 0 -1.5707963267948966
            $(arg camera_link_frame) $(arg optical_frame) 100"/>
  </group>

  <group if="$(eval arg('mode') == 'validation' and arg('publish_truth_tf'))">
    <node pkg="tf" type="static_transform_publisher" name="$(arg model_name)_validation_truth_pose"
          args="$(arg x) $(arg y) $(arg z) $(arg yaw) $(arg pitch) $(arg roll)
            $(arg parent_frame) $(arg gt_camera_link_frame) 100"/>
    <node pkg="tf" type="static_transform_publisher" name="$(arg model_name)_validation_optical_frame"
          args="0.067 0 0 -1.5707963267948966 0 -1.5707963267948966
            $(arg gt_camera_link_frame) $(arg gt_optical_frame) 100"/>
  </group>

</launch>
